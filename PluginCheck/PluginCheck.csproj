<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <REFrameworkRoot Condition="'$(REFrameworkRoot)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Devil May Cry 5\reframework\plugins</REFrameworkRoot>
    <REFrameworkGeneratedRoot Condition="'$(REFrameworkGeneratedRoot)' == ''">$(REFrameworkRoot)\managed\generated</REFrameworkGeneratedRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Plugin\DMC5DualSense.cs" Link="DMC5DualSense.cs" />
    <Reference Include="REFramework.NET">
      <HintPath>$(REFrameworkRoot)\REFramework.NET.dll</HintPath>
    </Reference>
    <Reference Include="REFramework.NET._mscorlib">
      <HintPath>$(REFrameworkGeneratedRoot)\REFramework.NET._mscorlib.dll</HintPath>
    </Reference>
    <Reference Include="REFramework.NET.viacore">
      <HintPath>$(REFrameworkGeneratedRoot)\REFramework.NET.viacore.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
